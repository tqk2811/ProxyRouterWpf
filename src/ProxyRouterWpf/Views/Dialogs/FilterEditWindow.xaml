<Window x:Class="ProxyRouterWpf.Views.Dialogs.FilterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ProxyRouterWpf.Views.Controls"
        Title="Filter" Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display">
    <Border BorderBrush="{DynamicResource Brush.Surface.BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.TitleBar.Background}" Padding="16,12" MouseLeftButtonDown="Header_Drag">
                <TextBlock Text="{DynamicResource Str.Dialog.Filter.EditTitle}" FontWeight="SemiBold" FontSize="14"/>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
                <Button Content="{DynamicResource Str.Common.Cancel}" Click="Cancel_Click" MinWidth="84"/>
                <Button Content="{DynamicResource Str.Common.Save}" Style="{StaticResource AccentButton}" Click="Ok_Click" MinWidth="84" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Margin="16,14">
                <Label Content="{DynamicResource Str.Dialog.Filter.Type}"/>
                <ComboBox x:Name="TypeBox" SelectionChanged="TypeBox_Changed"/>
                <StackPanel x:Name="DirPanel" Margin="0,10,0,0">
                    <Label Content="{DynamicResource Str.Dialog.Filter.Direction}"/>
                    <ComboBox x:Name="DirBox">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumLoc}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="BytesPanel" Margin="0,10,0,0">
                    <Label Content="{DynamicResource Str.Dialog.Filter.BytesLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BytesBox" Grid.Column="0" MaxLength="24"
                                 ctl:NumericInput.DigitsOnly="True" ctl:NumericInput.AllowDecimal="True"/>
                        <ComboBox x:Name="UnitBox" Grid.Column="2"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Str.Dialog.Filter.TotalBytesHint}" TextWrapping="Wrap"
                               Opacity="0.7" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="FilterPanel" Margin="0,10,0,0">
                    <Label Content="{DynamicResource Str.Dialog.Filter.HostLabel}"/>
                    <TextBox x:Name="FilterBox"/>
                </StackPanel>
                <CheckBox x:Name="IsNotBox" Content="{DynamicResource Str.Dialog.Filter.Not}" Margin="0,12,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
